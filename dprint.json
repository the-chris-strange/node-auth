{
  "json": {},
  "toml": {
    "indentTables": "never",
    "indentEntries": "never",
    "sortKeys": true,
    "preferSingleLine": true,
    "array.spaceSurroundingBrackets": true
  },
  "ruff": {
    "indentWidth": 4,
    "indentStyle": "space",
    "lineLength": 88,
    "quoteStyle": "single",
    "lineEnding": "lf"
  },
  "yaml": {
    "printWidth": 88,
    "formatComments": true
  },
  "exec": {
    "cwd": "${configDir}",
    "commands": [
      {
        "command": "rustfmt",
        "exts": ["rs"]
      },
      {
        "command": "rumdl fmt --silent --stdin-filename {{file_path}} -",
        "exts": ["md", "markdown"],
        "cacheKeyFiles": [".rumdl.toml"]
      }
    ]
  },
  "excludes": ["**/*-lock.json"],
  "plugins": [
    "npm:@dprint/json@0.25.2",
    "npm:@dprint/toml@0.9.0",
    "npm:@dprint/ruff@0.11.1",
    "npm:dprint-plugin-yaml@0.6.0",
    "npm:@dprint/exec@0.8.0/plugin.json@9d6234ea05810c775f388c2a4cce82b9116b69294b65e0e1e9d64f1446283ef3"
  ]
}
