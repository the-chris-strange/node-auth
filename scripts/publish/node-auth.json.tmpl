{
  "version": "${version}",
  "description": "Authenticate Node package managers to Google Artifact Registry",
  "homepage": "https://github.com/the-chris-strange/node-auth",
  "license": "Apache-2.0",
  "architecture": {
    "64bit": {
      "url": "https://github.com/the-chris-strange/node-auth/releases/download/${tag}/node-auth-${tag}-x86_64-pc-windows-msvc.zip",
      "hash": "${windows_sha}"
    }
  },
  "bin": [
    "node-auth.exe",
    "artifactregistry-auth.exe",
    "node-auth-token.exe"
  ],
  "checkver": {
    "github": "https://github.com/the-chris-strange/node-auth"
  },
  "autoupdate": {
    "architecture": {
      "64bit": {
        "url": "https://github.com/the-chris-strange/node-auth/releases/download/v$$version/node-auth-v$$version-x86_64-pc-windows-msvc.zip"
      }
    }
  }
}
